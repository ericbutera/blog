---
import CsvChart from "./CsvChart.astro";
import trainingCsv from "../data/training.csv?raw";
import { createChartData } from "../lib/chart-data";
import { parseCsv, parseDurationHours, parseNumber } from "../lib/csv";
import type { CsvRow } from "../lib/csv";

type ReportValue = "number" | "durationHours";

interface Report {
  key: string;
  label: string;
  source: string;
  unit: string;
  value: ReportValue;
  maximumFractionDigits?: number;
}

const reports: Report[] = [
  {
    key: "distance",
    label: "Distance",
    source: "Total Distance",
    unit: "mi",
    value: "number",
  },
  {
    key: "activityTime",
    label: "Activity Time",
    source: "Total Activity Time",
    unit: "hours",
    value: "durationHours",
    maximumFractionDigits: 1,
  },
  {
    key: "ascent",
    label: "Total Ascent",
    source: "Total Ascent",
    unit: "ft",
    value: "number",
  },
  {
    key: "heartRate",
    label: "Average Heart Rate",
    source: "Average Heart Rate",
    unit: "bpm",
    value: "number",
  },
  {
    key: "speed",
    label: "Average Speed",
    source: "Average Speed",
    unit: "mph",
    value: "number",
    maximumFractionDigits: 1,
  },
];

function parseReportValue(row: CsvRow, report: Report): number {
  const rawValue = row[report.source] ?? "0";

  if (report.value === "durationHours") {
    return parseDurationHours(rawValue);
  }

  return parseNumber(rawValue);
}

const rows = parseCsv(trainingCsv)
  .filter((row) => /^\d{4}$/.test(row["Time Period"] ?? ""))
  .sort(
    (left, right) =>
      Number(left["Time Period"]) - Number(right["Time Period"]),
  );

const chartData = createChartData(
  rows,
  (row) => row["Time Period"],
  reports.map((report) => ({
    key: report.key,
    label: report.label,
    unit: report.unit,
    maximumFractionDigits: report.maximumFractionDigits,
    value: (row) => parseReportValue(row, report),
  })),
);
---

<CsvChart
  ariaLabel="Yearly training totals"
  className="training-chart"
  controls={reports.map(({ key, label }) => ({ key, label }))}
  data={chartData}
  defaultSeriesKey={reports[0].key}
  title="Yearly Training Totals"
  type="bar"
  xAxisTitle="Year"
/>
