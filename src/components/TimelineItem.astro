---
interface Props {
  date: string;
  datetime: string;
  title: string;
  side?: "start" | "end";
  isFirst?: boolean;
  isLast?: boolean;
  iconHtml?: string;
}

const {
  date,
  datetime,
  title,
  side = 'start',
  isFirst = false,
  isLast = false,
  iconHtml,
} = Astro.props;
---

<li>
  {!isFirst && <hr />}
  <div class="timeline-middle" aria-hidden="true">
    {
      iconHtml ? (
        <span class="timeline-icon" set:html={iconHtml} />
      ) : (
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
            clip-rule="evenodd"
          />
        </svg>
      )
    }
  </div>
  <div
    class:list={[
      side === 'start' ? 'timeline-start' : 'timeline-end',
      side === 'start' ? 'mb-10 md:text-end' : 'md:mb-10',
    ]}
  >
    <time datetime={datetime} class="font-mono italic">{date}</time>
    <div class="text-lg font-black">{title}</div>
    <slot />
  </div>
  {!isLast && <hr />}
</li>
